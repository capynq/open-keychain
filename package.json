{
  "name": "open-keychain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WilfredoN/open-keychain.git"
  },
  "homepage": "https://github.com/WilfredoN/open-keychain#readme",
  "bugs": {
    "url": "https://github.com/WilfredoN/open-keychain/issues"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "bench:geometry": "node --import tsx scripts/bench-geometry.ts",
    "bench:matrix": "node --import tsx scripts/bench-matrix.ts",
    "server": "tsx server/index.ts",
    "server:typecheck": "tsc -p tsconfig.node.json --pretty false",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "better-auth": "^1.6.26",
    "fastify": "^5.11.3",
    "fflate": "0.8.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "manifold-3d": "3.5.1",
    "opentype.js": "2.0.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.0.15",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "sharp": "^0.35.3",
    "tsx": "4.20.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,scss,html,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
