{
  "name": "open-keychain",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "bench:geometry": "node --import tsx scripts/bench-geometry.ts",
    "bench:matrix": "node --import tsx scripts/bench-matrix.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "manifold-3d": "3.5.1",
    "opentype.js": "2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.0.15",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.2",
    "@vitejs/plugin-react": "5.1.1",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "27.0.0",
    "prettier": "3.9.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vitest": "4.1.10",
    "typescript-eslint": "8.66.0"
  }
}
