{
  "name": "open-keychain",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/capynq/open-keychain.git"
  },
  "homepage": "https://open-keychain.com/",
  "bugs": {
    "url": "https://github.com/capynq/open-keychain/issues"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build:artifact",
    "build:artifact": "pnpm seo:sitemap && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/build/run-tsc.mjs -b --pretty false",
    "typecheck:watch": "node scripts/build/run-tsc.mjs -b --watch --pretty false",
    "test": "vitest run",
    "test:full": "vitest run",
    "test:fast": "vitest run --exclude src/domain/keychain/build/keychain-builder.contracts.test.ts --exclude src/domain/keychain/build/keychain-builder.styles-fonts.test.ts --exclude src/domain/keychain/build/keychain-builder.magnet-nameplate-plant.test.ts --exclude src/domain/keychain/build/keychain-builder.keyring-articulated.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:full": "pnpm exec playwright test --workers=2 && pnpm test:e2e:workspace",
    "test:e2e:workspace": "VITE_HOSTED_MODE=true PLAYWRIGHT_USE_EXISTING_BUILD=false playwright test e2e/workspace.spec.ts --project=desktop --workers=1",
    "test:e2e:smoke": "PLAYWRIGHT_SMOKE=true playwright test e2e/smoke.spec.ts --project=desktop --project=mobile --workers=2",
    "test:e2e:performance": "PLAYWRIGHT_PERFORMANCE=true playwright test e2e/performance.spec.ts --workers=1",
    "capture:ui": "pnpm build && playwright test --config playwright.capture.config.ts",
    "test:watch": "vitest",
    "bench:geometry": "node --import tsx scripts/geometry/checks/bench-geometry.ts",
    "bench:matrix": "node --import tsx scripts/geometry/matrix/bench-matrix-parent.ts",
    "bench:matrix:sample": "node --import tsx scripts/geometry/matrix/bench-matrix-parent.ts --sample=100",
    "test:geometry:matrix": "node --import tsx scripts/geometry/matrix/bench-matrix-parent.ts",
    "validate:matrix:shards": "node --import tsx scripts/geometry/matrix/validate-matrix-shards.ts",
    "validation:fixtures": "node --import tsx scripts/geometry/checks/generate-validation-fixtures.ts",
    "assets:landing": "node scripts/generators/generate-landing-assets.mjs",
    "seo:sitemap": "node --import tsx scripts/generators/generate-seo-sitemap.ts",
    "validate:seo": "pnpm seo:sitemap --check && vitest run src/infrastructure/seo/app-metadata.test.ts src/infrastructure/seo/sitemap.test.ts",
    "validate:slicer": "node --import tsx scripts/geometry/checks/validate-slicer.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:changed": "node scripts/validation/commands/validate-changed.mjs",
    "validate:push": "node scripts/validation/commands/run-validation-gates.mjs push",
    "validate:full": "node scripts/validation/commands/run-validation-gates.mjs full",
    "validate:ci": "node scripts/validation/commands/run-validation-gates.mjs ci",
    "validate:ci:changed": "node scripts/validation/commands/run-validation-gates.mjs ci-changed",
    "validate:ci:browser": "node scripts/validation/commands/run-validation-gates.mjs ci-browser",
    "validate:ci:geometry": "node scripts/validation/commands/run-validation-gates.mjs ci-geometry",
    "validate:bench": "node scripts/validation/commands/bench-validation.mjs",
    "validate:cache:clear": "node scripts/validation/commands/run-validation-gates.mjs cache-clear",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "fix": "pnpm format && pnpm lint:fix",
    "validate": "pnpm validate:ci",
    "prepare": "husky"
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.49.0",
    "manifold-3d": "3.5.4",
    "opentype.js": "2.0.0",
    "posthog-js": "^1.435.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.15",
    "react-router": "^8.4.0",
    "three": "0.186.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-no-barrel-files": "^2.2.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "husky": "^9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.9",
    "sharp": "^0.35.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.1",
    "webmcp-types": "0.1.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,scss,html,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
