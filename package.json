{
  "name": "open-keychain",
  "private": true,
  "version": "0.1.0-beta.1",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/capynq/open-keychain.git"
  },
  "homepage": "https://open-keychain.com/",
  "bugs": {
    "url": "https://github.com/capynq/open-keychain/issues"
  },
  "engines": {
    "node": ">=22.22.1",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && pnpm build:artifact",
    "build:artifact": "vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/run-tsc.mjs -b --pretty false",
    "typecheck:watch": "node scripts/run-tsc.mjs -b --watch --pretty false",
    "test": "vitest run",
    "test:full": "vitest run",
    "test:fast": "vitest run --exclude src/domain/keychain/build/keychain-builder.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "PLAYWRIGHT_SMOKE=true playwright test e2e/smoke.spec.ts --project=desktop --project=mobile --workers=2",
    "test:e2e:performance": "PLAYWRIGHT_PERFORMANCE=true playwright test e2e/performance.spec.ts --workers=1",
    "capture:ui": "pnpm build && playwright test --config playwright.capture.config.ts",
    "test:watch": "vitest",
    "bench:geometry": "node --import tsx scripts/bench-geometry.ts",
    "bench:matrix": "node --import tsx scripts/bench-matrix-parent.ts",
    "test:geometry:matrix": "node --import tsx scripts/bench-matrix-parent.ts",
    "validation:fixtures": "node --import tsx scripts/generate-validation-fixtures.ts",
    "validate:slicer": "node --import tsx scripts/validate-slicer.ts",
    "server": "tsx server/index.ts",
    "server:typecheck": "node scripts/run-tsc.mjs -p tsconfig.node.json --pretty false",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "validate:changed": "node scripts/validate-changed.mjs",
    "validate:ci": "node scripts/run-validation-gates.mjs",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "fix": "pnpm format && pnpm lint:fix",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "better-auth": "^1.6.29",
    "embla-carousel-react": "^8.6.0",
    "fastify": "^5.12.0",
    "fflate": "0.8.3",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.35.0",
    "manifold-3d": "3.5.1",
    "opentype.js": "2.0.0",
    "pg": "^8.23.0",
    "posthog-js": "^1.417.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.11",
    "react-router": "^8.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "husky": "^9.1.7",
    "jsdom": "30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "sharp": "^0.35.3",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{css,scss,html,json,md,mdx,yml,yaml}": [
      "prettier --write"
    ]
  }
}
