set -e

if command -v pnpm >/dev/null 2>&1; then
  if ! git diff --quiet || ! git diff --cached --quiet; then
    echo "pre-push: commit or stash tracked changes before automatic repair." >&2
    exit 1
  fi

  # Repair tracked files before validation so fixable formatting/lint issues
  # are folded into the commit being pushed. Untracked files are left alone.
  pnpm fix
  git add -u

  pnpm validate

  if ! git diff --cached --quiet; then
    git commit --amend --no-edit --no-verify
    echo "pre-push: automatic fixes were committed; run git push again." >&2
    exit 1
  fi
fi
