# Install as /etc/nginx/sites-available/api.open-keychain.com, replace the
# certificate paths, then run `nginx -t` before `systemctl reload nginx`.

server {
    listen 80;
    listen [::]:80;
    server_name api.open-keychain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.open-keychain.com;

    ssl_certificate /etc/letsencrypt/live/api.open-keychain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.open-keychain.com/privkey.pem;

    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_no_cache 1;
        add_header Cache-Control "no-store" always;
    }
}
