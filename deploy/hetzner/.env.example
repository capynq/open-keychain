# Copy to /etc/open-keychain/api.env on the Hetzner host. Keep the real file
# outside Git and chmod it 600. The API container reaches Postgres by service name.
POSTGRES_DB=open_keychain
POSTGRES_USER=open_keychain
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://open_keychain:replace-with-a-long-random-password@open-keychain-postgres:5432/open_keychain
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
APP_URL=https://open-keychain.com
HOST=0.0.0.0
PORT=3000
ANONYMOUS_WEEKLY_EXPORTS=3
PAID_DAILY_EXPORTS=200
PAID_MINUTE_EXPORTS=6
