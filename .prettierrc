{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "objectWrap": "preserve",
  "overrides": [
    {
      "files": [
        "*.md",
        "*.mdx",
        "*.json",
        "*.css",
        "*.scss",
        "*.html",
        "*.yml",
        "*.yaml",
        "*.d.ts"
      ],
      "options": {
        "printWidth": 120
      }
    }
  ]
}
