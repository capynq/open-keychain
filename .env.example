# Browser build (all VITE_* values are public and embedded in the bundle)
VITE_GOOGLE_FONTS_API_KEY=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Enable only when the hosted API and secure production cookies are configured.
VITE_HOSTED_MODE=false
# Same-origin APIs can leave this empty. This value is public in the browser bundle.
VITE_API_BASE_URL=

# Optional externally hosted API
APP_URL=http://localhost:5173
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/open_keychain
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
ANONYMOUS_WEEKLY_EXPORTS=3
PAID_DAILY_EXPORTS=200
PAID_MINUTE_EXPORTS=6
